<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <query name="info.gianlucacosta.historymark.ReadAges">
        <![CDATA[
        SELECT age
        FROM Age age
        ORDER BY age.start, age.end
        ]]>
    </query>

    <query name="info.gianlucacosta.historymark.ReadPins">
        <![CDATA[
        SELECT pin
        FROM Pin pin
        ]]>
    </query>
</hibernate-mapping>